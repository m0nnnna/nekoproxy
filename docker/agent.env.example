# NekoProxy Agent — Docker environment configuration
# Copy this file to docker/agent.env and set your values.

# ── Identity ─────────────────────────────────────────────────────────────────
# Override the agent hostname shown in the controller UI (defaults to container hostname).
# NEKO_AGENT_HOSTNAME=my-agent-01

# WireGuard IP (optional — leave unset for agents that connect without WireGuard).
# NEKO_AGENT_WIREGUARD_IP=10.0.0.2

# Public IP of this agent (optional — used in stats and email proxy deployment).
# NEKO_AGENT_PUBLIC_IP=203.0.113.10

# ── Authentication ───────────────────────────────────────────────────────────
# Token the controller sends when calling this agent's ControlAPI.
# Must match NEKO_CONTROLLER_TOKEN on the controller.
# NEKO_AGENT_CONTROLLER_TOKEN=another-strong-random-token

# Shared secret for agent registration (must match NEKO_AGENT_SECRET on controller).
# NEKO_AGENT_SECRET=shared-registration-secret

# ── TLS ──────────────────────────────────────────────────────────────────────
# Set to false when controller uses a self-signed cert without a shared CA.
# NEKO_AGENT_CONTROLLER_SSL_VERIFY=true

# Path to CA cert for verifying a self-signed controller certificate.
# NEKO_AGENT_CONTROLLER_SSL_CA_CERT=/certs/controller-ca.pem

# ── Proxy behaviour ──────────────────────────────────────────────────────────
# NEKO_AGENT_RATE_LIMIT_PER_MINUTE=60
# NEKO_AGENT_RATE_LIMIT_AUTO_BLOCK=true

# ── Upstream / forward proxy ──────────────────────────────────────────────────
# Route all agent→backend connections through a forward proxy so traffic exits
# from the VPS IP rather than from this host.
# Supported schemes: socks5, socks4, http
# NEKO_AGENT_UPSTREAM_PROXY=socks5://1.2.3.4:1080

# ── Forward proxy server ──────────────────────────────────────────────────────
# Accept HTTP/HTTPS proxy connections from devices on the network (0 = disabled).
# Devices point their proxy settings at this agent's IP and this port.
# If NEKO_AGENT_UPSTREAM_PROXY is also set, outbound traffic exits from the VPS.
# NEKO_AGENT_FORWARD_PROXY_PORT=8080
# Optional Basic auth (Proxy-Authorization header). Format: user:password
# NEKO_AGENT_FORWARD_PROXY_AUTH=myuser:mypassword
