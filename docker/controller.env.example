# NekoProxy Controller — Docker environment configuration
# Copy this file to docker/controller.env and set your values.
# Lines starting with # are comments and are ignored.

# ── Admin API token ──────────────────────────────────────────────────────────
# Required for web UI login and all API requests.
# If not set, a random token is generated on first start and printed to the logs.
# NEKO_API_TOKEN=your-strong-random-token-here

# ── Controller → Agent token ─────────────────────────────────────────────────
# Token sent in X-Controller-Token when the controller calls agent ControlAPI.
# Must match NEKO_AGENT_CONTROLLER_TOKEN on every agent.
# If not set, auto-generated on first start.
# NEKO_CONTROLLER_TOKEN=another-strong-random-token

# ── Agent registration secret ────────────────────────────────────────────────
# If set, agents must provide this secret to register. Recommended in production.
# Must match NEKO_AGENT_SECRET on every agent.
# NEKO_AGENT_SECRET=shared-registration-secret

# ── TLS / HTTPS ──────────────────────────────────────────────────────────────
# Paths inside the container. Mount your certs via a Docker volume:
#   volumes:
#     - ./certs:/certs:ro
# NEKO_SSL_CERTFILE=/certs/controller-cert.pem
# NEKO_SSL_KEYFILE=/certs/controller-key.pem

# ── Misc ─────────────────────────────────────────────────────────────────────
# NEKO_DEBUG=false
# NEKO_STATS_RETENTION_DAYS=30
