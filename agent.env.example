# NekoProxy Agent configuration (Windows)
# Copy to "agent.env" in the same folder as nekoproxy-agent.exe.
# install-agent.ps1 creates this file for you if it is missing.

# --- Required ---
# Controller URL. Use https:// if the controller has TLS enabled (default).
NEKO_AGENT_CONTROLLER_URL=https://10.0.0.1:8001

# Display name for this agent in the controller UI.
NEKO_AGENT_HOSTNAME=win-proxy-1

# --- Full agent (WireGuard) ---
# This agent's WireGuard IP. Omit for an internal agent (no VPN).
#NEKO_AGENT_WIREGUARD_IP=10.0.0.5

# --- Internal agent (no WireGuard) ---
# URL the controller uses to reach this agent's Control API. Required for internal agents.
#NEKO_AGENT_CONTROL_URL=https://127.0.0.1:8002

# --- Optional ---
#NEKO_AGENT_PUBLIC_IP=203.0.113.10
#NEKO_AGENT_API_PORT=8002
# Registration secret; must match NEKO_AGENT_SECRET on the controller if set.
#NEKO_AGENT_AGENT_SECRET=
# Forward proxy port (normally set from the controller Settings page).
#NEKO_AGENT_FORWARD_PROXY_PORT=8080
