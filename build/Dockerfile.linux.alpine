# Build NekoProxy Linux binaries for Alpine (musl libc).
# Use these binaries on Alpine Linux only; for Ubuntu/Debian use Dockerfile.linux (glibc).

FROM alpine:3.19

RUN apk add --no-cache \
    bash \
    python3 \
    py3-pip \
    python3-dev \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    libstdc++ \
    && ln -sf python3 /usr/bin/python

WORKDIR /build

COPY requirements.txt .

RUN pip install --break-system-packages --upgrade pip && \
    pip install --break-system-packages pyinstaller && \
    pip install --break-system-packages -r requirements.txt

COPY . .

RUN find . -name "*.sh" -type f -exec sed -i 's/\r$//' {} \; 2>/dev/null || true

COPY build/docker-build.sh /docker-build.sh
RUN sed -i 's/\r$//' /docker-build.sh 2>/dev/null || true && chmod +x /docker-build.sh

ENTRYPOINT ["/docker-build.sh"]
